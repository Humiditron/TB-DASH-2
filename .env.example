# ==============================================================================
# HUMID1 Domain Map & Ecosystem Environment Variables
# All variables can be configured at build-time or hotloaded at container runtime.
# ==============================================================================

# Dashboard (This UI)
VITE_DASHBOARD_URL=https://dash.humid1.com

# ThingsBoard IoT Core (Port 8080)
VITE_THINGSBOARD_SERVER_URL=https://app.humid1.com
VITE_THINGSBOARD_URL=https://app.humid1.com

# Authentik Identity Provider (Port 9000)
VITE_AUTHENTIK_URL=https://auth.humid1.com
VITE_AUTHENTIK_APP_SLUG=humid1-dash
VITE_AUTHENTIK_SLUG=humid1-dash
VITE_AUTHENTIK_CLIENT_ID=7nvidWHfM8C3wE3VKGqFNGFNnl9aou46mL5kporI

# Authentik OAuth2 SSO Authorization Redirect Endpoint
VITE_SSO_AUTH_ENDPOINT=https://app.humid1.com/oauth2/authorization/1efd3960-a10b-11f1-b530-9b9631e0c365

# Cap Captcha Security Service (Port 3000)
VITE_CAPTCHA_URL=https://cap.humid1.com

# Chatto Support / Messaging Platform (Port 4000)
VITE_CHAT_URL=https://chat.humid1.com

# App Metadata & Display Defaults
VITE_APP_TITLE=HUMID1_OS
VITE_APP_DESCRIPTION=Precision Humidor Monitoring & Telemetry Stack
VITE_DEFAULT_DEVICE_NAME=HUMID1-CABINET-01
VITE_APP_REDIRECT_URI=

